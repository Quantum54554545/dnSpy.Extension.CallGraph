<UserControl x:Class="dnSpy.CallGraph.call_graph_control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:dnSpy.CallGraph.Controls"
             MinWidth="560" MinHeight="360"
             Background="{DynamicResource SystemColorsWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource EnvironmentBackground}"
                BorderBrush="{DynamicResource CommonControlsTextBoxBorder}"
                BorderThickness="0,0,0,1" Padding="4,3">
            <StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="back_button" Content="←" ToolTip="Previous graph root" Width="27" Height="23" IsEnabled="False" />
                <Button x:Name="forward_button" Content="→" ToolTip="Next graph root" Width="27" Height="23" Margin="2,0,0,0" IsEnabled="False" />
                <Border Width="1" Height="19" Margin="7,0" Background="{DynamicResource CommonControlsTextBoxBorder}" />
                <Button x:Name="load_selection_button" Content="Current selection" Height="23" Padding="7,0"
                        ToolTip="Build the selected view for the current method" />
                <Border Width="1" Height="19" Margin="7,0" Background="{DynamicResource CommonControlsTextBoxBorder}" />
				<TextBlock x:Name="graph_label" Text="Graph" Margin="0,0,3,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemColorsWindowText}" />
                <ComboBox x:Name="view_mode_combo_box" Width="104" Height="23"
                          ToolTip="Call blocks: code in method blocks&#x0a;Function map: fast constellation view&#x0a;CFG: IL basic blocks inside one method" />
                <Border Width="1" Height="19" Margin="7,0" Background="{DynamicResource CommonControlsTextBoxBorder}" />
				<TextBlock x:Name="calls_label" Text="Calls" Margin="0,0,3,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemColorsWindowText}" />
                <ComboBox x:Name="direction_combo_box" Width="84" Height="23"
                          ToolTip="Callees: what the selected block calls&#x0a;Callers: what calls the selected block&#x0a;Both: show both directions" />
				<TextBlock x:Name="depth_label" Text="Depth" Margin="8,0,3,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemColorsWindowText}" />
                <ComboBox x:Name="depth_combo_box" Width="45" Height="23" />
                <Border Width="1" Height="19" Margin="7,0" Background="{DynamicResource CommonControlsTextBoxBorder}" />
				<TextBlock x:Name="code_label" Text="Code" Margin="0,0,3,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemColorsWindowText}" />
                <ComboBox x:Name="language_combo_box" Width="59" Height="23" ToolTip="Decompiler used inside graph blocks" />
                <Border Width="1" Height="19" Margin="7,0" Background="{DynamicResource CommonControlsTextBoxBorder}" />
                <Button x:Name="center_button" Content="Center root" Height="23" Padding="7,0"
                        ToolTip="Center the current root block" />
                <Button x:Name="research_button" Content="Research" Height="23" Padding="7,0" Margin="5,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="search_label" Text="Search" Margin="3,0,6,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemColorsWindowText}" />
                <TextBox x:Name="search_text_box" Width="280" Height="23" Padding="4,1"
                         ToolTip="Find a visible method by name, type, or signature" />
                <Button x:Name="search_previous_button" Content="↑" Width="27" Height="23" Margin="3,0,0,0"
                        IsEnabled="False" />
                <Button x:Name="search_next_button" Content="↓" Width="27" Height="23" Margin="2,0,0,0"
                        IsEnabled="False" />
                <Button x:Name="clear_search_button" Content="×" Width="27" Height="23" Margin="2,0,0,0"
                        IsEnabled="False" />
                <TextBlock x:Name="search_result_text" Margin="7,0,0,0" MinWidth="70" VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemColorsGrayText}" />
                <Button x:Name="continue_refinement_button" Content="Continue refinement" Height="23" Padding="7,0" Margin="7,0,0,0" IsEnabled="False" />
                <Button x:Name="stop_refinement_button" Content="Stop" Height="23" Padding="7,0" Margin="3,0,0,0" IsEnabled="False" />
            </StackPanel>
            </StackPanel>
        </Border>

		<Border x:Name="graph_host_border" Grid.Row="1" BorderBrush="{DynamicResource CommonControlsTextBoxBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="research_column" Width="0" />
                </Grid.ColumnDefinitions>
                <controls:call_graph_surface x:Name="graph_surface" />
                <controls:function_map_surface x:Name="function_map_surface" Visibility="Collapsed" />
                <GridSplitter x:Name="research_splitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                <Border x:Name="research_pane" Grid.Column="2" MinWidth="300" Visibility="Collapsed"
                        BorderBrush="{DynamicResource CommonControlsTextBoxBorder}" BorderThickness="1,0,0,0"
                        Background="{DynamicResource EnvironmentBackground}">
                    <DockPanel Margin="7">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button x:Name="close_research_button" Content="×" DockPanel.Dock="Right" Width="23" Height="23" />
                            <TextBlock x:Name="research_title" Text="Research" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemColorsWindowText}" />
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button x:Name="cancel_research_button" Content="Cancel" HorizontalAlignment="Left" Padding="7,2" Visibility="Collapsed" />
                            <TextBlock x:Name="research_status" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource SystemColorsWindowText}" />
                        </StackPanel>
                        <Grid x:Name="evidence_panel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" MinHeight="28" MaxHeight="180" />
                                <RowDefinition Height="5" />
                                <RowDefinition Height="*" MinHeight="70" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="evidence_heading" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Foreground="{DynamicResource SystemColorsWindowText}" />
                            <ListBox x:Name="call_sites_list" Grid.Row="1" DisplayMemberPath="title" Height="Auto" MinHeight="28" MaxHeight="180"
                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                                          Background="{DynamicResource CommonControlsTextBoxBorder}" />
                            <TextBox x:Name="evidence_text_box" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                                     Height="Auto" MinHeight="0" MaxHeight="Infinity" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource EnvironmentBackground}"
                BorderBrush="{DynamicResource CommonControlsTextBoxBorder}" BorderThickness="1,0,1,1"
                Padding="7,3">
            <TextBlock x:Name="status_text" Text="Select a method and click Current method"
                       Foreground="{DynamicResource SystemColorsWindowText}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <ProgressBar x:Name="busy_progress" Grid.Row="3" IsIndeterminate="True" Visibility="Collapsed" />
    </Grid>
</UserControl>
