<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>CallGraph.Validation</AssemblyName>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\call_graph.extension.csproj" />
    <Reference Include="dnlib"><HintPath>$(DnSpyBinDir)\dnlib.dll</HintPath></Reference>
    <Reference Include="dnSpy.Contracts.DnSpy"><HintPath>$(DnSpyBinDir)\dnSpy.Contracts.DnSpy.dll</HintPath></Reference>
    <Reference Include="dnSpy.Contracts.Logic"><HintPath>$(DnSpyBinDir)\dnSpy.Contracts.Logic.dll</HintPath></Reference>
    <Reference Include="System.ComponentModel.Composition"><HintPath>$(DnSpyBinDir)\System.ComponentModel.Composition.dll</HintPath></Reference>
    <Reference Include="Microsoft.VisualStudio.Text.Data"><HintPath>$(DnSpyBinDir)\Microsoft.VisualStudio.Text.Data.dll</HintPath></Reference>
  </ItemGroup>
</Project>
